# Contact form delivery (app/api/contact).
# Without these the form returns a clear error and offers the direct email
# address instead — it never silently drops an enquiry.

# https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries land. Defaults to BUSINESS.email in content/legal.ts.
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain you have verified in Resend,
# e.g. "Dylan Coleman <hello@dylan-coleman.com>".
CONTACT_FROM_EMAIL=

# Canonical origin, if it ever differs from the default in lib/site.ts.
# Must be the host Vercel serves with a 200 — today that is the www form,
# because the apex 308-redirects to it. Setting this wrong points every
# canonical, og:url and sitemap entry at a redirect.
# NEXT_PUBLIC_SITE_URL=https://www.dylan-coleman.com
